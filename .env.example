# Copy to .env for local development (never commit .env)
PORT=3000
DEMO_MODE=true                      # set to false to send real messages through AWS

AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# AWS End User Messaging SMS / RCS
EUM_SMS_ORIGINATION_ID=             # phone number, sender ID or pool ID/ARN (SMS + fallback)
EUM_RCS_AGENT_ID=                   # RCS agent ID or ARN (must be Active)
EUM_CONFIG_SET=                     # optional configuration set name
# RCS_TTL_SECONDS=3600              # optional message expiry

# AWS End User Messaging Social (WhatsApp)
WHATSAPP_PHONE_NUMBER_ID=           # e.g. phone-number-id-xxxxxxxx
WHATSAPP_META_API_VERSION=v20.0

# Amazon SES
SES_FROM_ADDRESS=                   # verified identity

# Amazon Bedrock AgentCore (optional; local rules are used if empty)
AGENTCORE_RUNTIME_ARN=
AGENTCORE_QUALIFIER=DEFAULT

# Inbound webhook + admin API
SNS_TOPIC_ARN=                      # only accept notifications from this topic
ADMIN_TOKEN=change-me               # Bearer token for /api/refill and /api/inbound
